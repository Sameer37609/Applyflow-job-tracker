{
  "name": "applyflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/ensure-database.mjs && prisma migrate dev",
    "db:deploy": "node scripts/ensure-database.mjs && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:api": "node --test tests/api.test.mjs",
    "test:demo": "tsx --test tests/demo.test.ts",
    "test:demo-api": "node --test tests/demo-api.test.mjs",
    "test:validation": "tsx --test tests/validation.test.ts",
    "test:analytics": "tsx --test tests/analytics.test.ts",
    "test:analytics-api": "tsx --test tests/analytics-api.test.ts"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.66.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "dotenv": "^18.0.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "7.10.1",
    "tsx": "^4"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.0.0"
  }
}
